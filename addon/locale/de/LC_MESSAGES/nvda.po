msgstr "Nur wenn Sonos im Vordergrund ist"

#: addon/globalPlugins/sonosSettings.py:122
msgid "&Log track titles"
msgstr "Titel &protokollieren"

#: addon/globalPlugins/sonosSettings.py:124
msgid "Log f&ilename:"
msgstr "Pr&otokolldatei:"

#: addon/globalPlugins/sonosSettings.py:126
msgid "&Browse..."
msgstr "&Durchsuchen..."

#: addon/globalPlugins/sonosSettings.py:127
msgid "&Open"
msgstr "&Öffnen"

#: addon/globalPlugins/sonosSettings.py:132
msgid "Ad&vanced..."
msgstr "Er&weitert..."

#. Translators: This key is a random UUID identifying the installation, not an API credential.
#: addon/globalPlugins/sonosSettings.py:141
msgid "Lyrics key (random installation ID). Leave blank to generate a new key:"
msgstr "Songtextschlüssel (zufällige Installations-ID). Leer lassen, um einen neuen Schlüssel zu erzeugen:"

#: addon/globalPlugins/sonosSettings.py:142
msgid "Advanced Sonos settings"
msgstr "Erweiterte Sonos-Einstellungen"

#: addon/globalPlugins/sonosSettings.py:153
msgid "Enter a valid lyrics key, or leave it blank to generate one."
msgstr "Geben Sie einen gültigen Songtextschlüssel ein oder lassen Sie das Feld leer, um einen neuen zu erzeugen."

#: addon/globalPlugins/sonosSettings.py:168
msgid "Choose track log file"
msgstr "Protokolldatei auswählen"

#: addon/globalPlugins/sonosSettings.py:177
msgid "No track log file yet."
msgstr "Noch keine Protokolldatei vorhanden."

#: addon/globalPlugins/sonosSettings.py:181
msgid "Could not open the track log."
msgstr "Protokolldatei konnte nicht geöffnet werden."

#: addon/globalPlugins/sonosSettings.py:192
msgid "Choose a log filename in an existing folder."
msgstr "Einen Protokolldateinamen in einem vorhandenen Ordner wählen."

#: addon/globalPlugins/sonosSettings.py:193
msgid "Log filename"
msgstr "Protokolldatei"

#: addon/globalPlugins/sonosSettings.py:246
msgid "Log started"
msgstr "Protokollierung gestartet"

#: addon/globalPlugins/sonosSettings.py:260
msgid "Log ended"
msgstr "Protokollierung beendet"

#: addon/globalPlugins/sonosSettings.py:322
msgid "Could not write the track log. Track logging off."
msgstr "Protokolldatei konnte nicht geschrieben werden. Titelprotokollierung aus."

#: buildVars.py:14
msgid "Sonos Redux"
msgstr "Sonos Redux"

#: buildVars.py:15
msgid "Accessibility enhancements for the Sonos Desktop app including now playing, track scrubbing, speech feedback for Sonos hotkeys, and much more."
msgstr "Verbesserte Zugänglichkeit für die Sonos-Desktop-Anwendung mit Informationen zum aktuellen Titel, Vor- und Zurückspringen im Titel, Sprachausgabe für Sonos-Tastenkürzel und vielem mehr."

#: buildVars.py:17
msgid "Added support for translations via Crowdin. Improved speech in several dialogs, including Alarms, Add Radio Station, and About."
msgstr "Unterstützung für Übersetzungen über Crowdin hinzugefügt. Verbesserte Sprachausgabe in mehreren Dialogen, darunter Wecker, Radiosender hinzufügen und Info."

