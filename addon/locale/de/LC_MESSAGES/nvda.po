msgid "Sonos"
msgstr "Sonos"

msgid "Accessibility enhancements for the Sonos Desktop app including now playing, track scrubbing, speech feedback for Sonos hotkeys, and much more."
msgstr "Verbesserte Zugänglichkeit für die Sonos-Desktop-Anwendung mit Informationen zum aktuellen Titel, Vor- und Zurückspringen im Titel, Sprachausgabe für Sonos-Tastenkürzel und vielem mehr."

msgid "Added lyrics lookup and saving, track announcements, sleep timer status, volume controls and fade out, looping bookmarks, and more flexible track seeking. Improved Now Playing information and SiriusXM channel reporting."
msgstr ""

msgid "Report the current track position."
msgstr "Aktuelle Titelposition ansagen."

msgid "Focus the track scrubber."
msgstr "Den Positionsregler fokussieren."

msgid "Seek backward."
msgstr "Zurückspringen."

msgid "Seek forward."
msgstr "Vorspringen."

msgid "Report elapsed track time."
msgstr "Verstrichene Titelzeit ansagen."

msgid "Report remaining track time."
msgstr "Verbleibende Titelzeit ansagen."

msgid "Set the selected speaker group's volume."
msgstr "Lautstärke der ausgewählten Lautsprechergruppe einstellen."

msgid "Volume for {group}:"
msgstr "Lautstärke für {group}:"

msgid "Set volume"
msgstr "Lautstärke einstellen"

msgid "The speaker group changed. Open Set Volume again."
msgstr "Die Lautsprechergruppe wurde gewechselt. Lautstärkedialog erneut öffnen."

msgid "Volume for {group}: {percent}%"
msgstr "Lautstärke für {group}: {percent}%"

msgid "Report the active room volume."
msgstr "Lautstärke des aktiven Raums ansagen."

msgid "Report mute state."
msgstr "Stummschaltung ansagen."

msgid "Toggle mute and report its state."
msgstr "Stummschaltung umschalten und Status ansagen."

msgid "Report repeat mode."
msgstr "Wiederholungsmodus ansagen."

msgid "Toggle repeat and report its mode."
msgstr "Wiederholungsmodus umschalten und ansagen."

msgid "Report shuffle state."
msgstr "Zufallswiedergabe ansagen."

msgid "Toggle shuffle and report its state."
msgstr "Zufallswiedergabe umschalten und Status ansagen."

msgid "Report crossfade state."
msgstr "Überblendung ansagen."

msgid "Toggle crossfade and report its state."
msgstr "Überblendung umschalten und Status ansagen."

msgid "Read the current track. Press twice quickly to copy track information."
msgstr "Aktuellen Titel vorlesen. Zweimal schnell drücken, um Titelinformationen zu kopieren."

msgid "Report the current speaker group."
msgstr "Aktuelle Lautsprechergruppe ansagen."

msgid "Group {group}"
msgstr "Gruppe {group}"

msgid "Select the previous speaker group."
msgstr "Vorherige Lautsprechergruppe auswählen."

msgid "Select the next speaker group."
msgstr "Nächste Lautsprechergruppe auswählen."

msgid "Show current track information in a browseable message."
msgstr "Aktuelle Titelinformationen in einem lesbaren Dialog anzeigen."

msgid "Search YouTube for the current track."
msgstr "Auf YouTube nach dem aktuellen Titel suchen."

msgid "This control is unavailable in the current Sonos view."
msgstr "Dieses Steuerelement ist in der aktuellen Sonos-Ansicht nicht verfügbar."

msgid "Sonos is not responding or the control is unavailable."
msgstr "Sonos antwortet nicht oder das Steuerelement ist nicht verfügbar."

msgid "Sonos command failed. See the NVDA log for details."
msgstr "Der Sonos-Befehl ist fehlgeschlagen. Einzelheiten stehen im NVDA-Protokoll."

msgid "The track scrubber does not accept keyboard focus."
msgstr "Der Positionsregler kann nicht mit der Tastatur fokussiert werden."

msgid "Now playing"
msgstr "Aktuelle Wiedergabe"

msgid "No track information is available."
msgstr "Es sind keine Titelinformationen verfügbar."

msgid "Could not open the web browser."
msgstr "Der Webbrowser konnte nicht geöffnet werden."

msgid "Copy the displayed album artwork to the clipboard."
msgstr "Das angezeigte Albumcover in die Zwischenablage kopieren."

msgid "Could not open the clipboard."
msgstr "Zwischenablage konnte nicht geöffnet werden."

msgid "Album artwork copied."
msgstr "Albumcover kopiert."

msgid "Could not copy album artwork."
msgstr "Albumcover konnte nicht kopiert werden."

msgid "{elapsed} of {total}, {percent}%"
msgstr "{elapsed} von {total}, {percent}%"

msgid "{time} remaining"
msgstr "{time} verbleibend"

msgid "Volume {percent}%"
msgstr "Lautstärke {percent}%"

msgid "{time} elapsed"
msgstr "{time} verstrichen"

msgid "Jump to a time in the current track."
msgstr "Zu einer Zeit im aktuellen Titel springen."

msgid "Track length {length}. Jump to:"
msgstr "Titellänge {length}. Springen zu:"

msgid "Jump to time"
msgstr "Zu einer Zeit springen"

msgid "Enter seconds, minutes:seconds, or hours:minutes:seconds, up to {length}. Use + or - for a relative jump."
msgstr "Sekunden, Minuten:Sekunden oder Stunden:Minuten:Sekunden eingeben, höchstens {length}. Mit + oder - relativ springen."

msgid "The track or room changed. Open Jump to Time again."
msgstr "Titel oder Raum wurde gewechselt. Den Dialog zum Springen erneut öffnen."

msgid "Group {group}, {milliseconds} milliseconds"
msgstr "Gruppe {group}, {milliseconds} Millisekunden"

msgid "Report sleep timer status."
msgstr "Status des Schlaf-Timers ansagen."

msgid "Sleep timer {time}"
msgstr "Schlaf-Timer {time}"

msgid "Sleep timer off"
msgstr "Schlaf-Timer aus"

msgid "Jump to the last seconds of the track."
msgstr "Zu den letzten Sekunden des Titels springen."

msgid "SiriusXM {channel}"
msgstr "SiriusXM {channel}"

msgid "No channel information is available."
msgstr "Keine Senderinformationen verfügbar."

msgid "Report the next track."
msgstr "Nächsten Titel ansagen."

msgid "Next {track}"
msgstr "Als Nächstes {track}"

msgid "No next track information is available."
msgstr "Es sind keine Informationen zum nächsten Titel verfügbar."

msgid "No track slider"
msgstr "Kein Positionsregler"

msgid "Enabled"
msgstr "Aktiviert"

msgid "Favorites"
msgstr "Favoriten"

msgid "Toggle track logging."
msgstr "Titelprotokollierung ein- oder ausschalten."

msgid "Track logging on"
msgstr "Titelprotokollierung ein"

msgid "Track logging off"
msgstr "Titelprotokollierung aus"

msgid "Toggle track announce."
msgstr "Ansage bei Titelwechseln umschalten."

msgid "Track announce everywhere"
msgstr "Titelwechsel überall ansagen"

msgid "Track announce only while Sonos is focused"
msgstr "Titelwechsel nur ansagen, wenn Sonos im Vordergrund ist"

msgid "Track announce off"
msgstr "Ansage bei Titelwechseln aus"

msgid "Track &announce:"
msgstr "Titelwechsel &ansagen:"

msgid "&Log track titles"
msgstr "Titel &protokollieren"

msgid "Log &filename:"
msgstr "Protokoll&datei:"

msgid "&Browse..."
msgstr "&Durchsuchen..."

msgid "Choose track log file"
msgstr "Protokolldatei auswählen"

msgid "Choose a log filename in an existing folder."
msgstr "Einen Protokolldateinamen in einem vorhandenen Ordner wählen."

msgid "Log filename"
msgstr "Protokolldatei"

msgid "Could not write the track log. Track logging off."
msgstr "Protokolldatei konnte nicht geschrieben werden. Titelprotokollierung aus."

msgid "Log started"
msgstr "Protokollierung gestartet"

msgid "Log ended"
msgstr "Protokollierung beendet"

msgid "&Open"
msgstr "&Öffnen"

msgid "No track log file yet."
msgstr "Noch keine Protokolldatei vorhanden."

msgid "Could not open the track log."
msgstr "Protokolldatei konnte nicht geöffnet werden."

msgid "Track &seek seconds:"
msgstr "&Sprungweite in Sekunden:"

msgid "Seek seconds from &end of track:"
msgstr "Sekunden vor Titel&ende:"

msgid "Group {group} ({members})"
msgstr "Gruppe {group} ({members})"

msgid "Report the number of tracks in the queue."
msgstr "Anzahl der Titel in der Warteschlange ansagen."

msgid "{count} track in queue"
msgid_plural "{count} tracks in queue"
msgstr[0] "{count} Titel in der Warteschlange"
msgstr[1] "{count} Titel in der Warteschlange"

msgid "Sonos Redux"
msgstr "Sonos Redux"

msgid "Off"
msgstr "Aus"

msgid "Everywhere"
msgstr "Überall"

msgid "Only while Sonos is focused"
msgstr "Nur wenn Sonos im Vordergrund ist"

msgid "Fade out the selected speaker group."
msgstr "Lautstärke der ausgewählten Lautsprechergruppe absenken."

msgid "Fading out {group}"
msgstr "Lautstärke für {group} wird abgesenkt"

msgid "&Fade seconds:"
msgstr "Absenk&dauer in Sekunden:"

msgid "No loop bookmark"
msgstr "Kein Schleifen-Lesezeichen"

msgid "Set loop start."
msgstr "Schleifenanfang setzen."

msgid "Loop start {time}"
msgstr "Schleifenanfang {time}"

msgid "Set loop end."
msgstr "Schleifenende setzen."

msgid "Loop end must be after loop start"
msgstr "Das Schleifenende muss nach dem Anfang liegen"

msgid "Loop end {time}"
msgstr "Schleifenende {time}"

msgid "Start looping."
msgstr "Schleife starten."

msgid "Set loop end first"
msgstr "Zuerst das Schleifenende setzen"

msgid "Loop on"
msgstr "Schleife ein"

msgid "Stop looping and continue playback."
msgstr "Schleife beenden und Wiedergabe fortsetzen."

msgid "Loop off"
msgstr "Schleife aus"

msgid "Report loop start, end, and duration."
msgstr "Schleifenanfang, Ende und Dauer ansagen."

msgid "Loop start {start}, end {end}, duration {duration}"
msgstr "Schleifenanfang {start}, Ende {end}, Dauer {duration}"

msgid "Playback is already paused"
msgstr "Die Wiedergabe ist bereits pausiert"

msgid "Could not confirm pause. Volume remains at zero."
msgstr "Pause konnte nicht bestätigt werden. Die Lautstärke bleibt bei null."
